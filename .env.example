# Copy to .env:  cp .env.example .env  (Windows: copy .env.example .env)

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=weather-raw

# --- Open-Meteo ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
POLL_SECONDS=60
TIMEZONE=Asia/Kolkata

# --- Postgres warehouse ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
WAREHOUSE_DB=weather_warehouse
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# Spark streaming checkpoint (local folder)
CHECKPOINT_DIR=./checkpoints

# --- Realtime scheduler app (realtime/orchestrator.py) ---
SOURCE_MODE=scenario          # scenario | api
SCENARIO=normal               # normal | heatwave | storm | cold_snap
BRONZE_EVERY_SECONDS=10        # API/scenario -> bronze
SILVER_EVERY_SECONDS=30        # bronze -> silver
GOLD_EVERY_SECONDS=60          # silver -> gold
